DATABASE_URL=postgresql+asyncpg://openkey:openkey@db:5432/openkey
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated browser origins (no wildcards, never *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
# chrome-extension:// and moz-extension:// origins are allowed by default
# so the standalone browser extension can call the API without listing IDs.
CORS_ALLOW_BROWSER_EXTENSIONS=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Set true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false
